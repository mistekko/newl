#! /usr/bin/env sh

theme_dir="$HOME/.local/share/wal-themes"
name="$(basename "$0")"
usage_message="Usage:
        $name                   choose a theme using dmenu and apply it
        $name h/-h/--help       print this help and exit

        $name a THEME           apply THEME
        $name d THEME           delete THEME
        $name e THEME           open THEME's colours.json in \$EDITOR ($EDITOR)
        $name i THEME           print info on current wallpaper if such exists
        $name l                 list valid theme names
        $name l-icewm-menu      format list of themes for an icewm menu entry
        $name n THEME           create 'THEME' from current pywal cache
        $name p THEME           edit a theme's post-application script
        $name r                 apply random theme
        $name s                 select theme graphically and apply it
        $name u THEME           write current pywal configuration to 'THEME'
        $name install THEME*    install all supplied THEMEs"

conf_dir="${XDG_CONFIG_HOME-"$HOME/.config"}"
wal_conf_dir="${conf_dir}/wal"
wal_cache_dir="${XDG_CACHE_HOME-"$HOME/.cache"}/wal"

# sh doesn't have floating-point arithmetic but COSMIC's
# config files use 1-normalised decimal values, so we'll
# have Pywal calculate decimal values for the accent colour
# using a template
[ -e "${wal_conf_dir}/templates/colors-decimal" ] \
	|| echo "{color1.red} {color1.green} {color1.blue}" \
	> "${wal_conf_dir}/templates/colors-decimal"

#
# Settings
#
dmenu_cmd="dmenu -p theme:  -nb $color0 -nf $color7 -sb $color9 -sf $color15"
sxiv_cmd="sxiv"
sxiv_flags="-bort"
icon_size="16" # in pixels; for icon generation, e.g. for icewm menus
xresources="$XDG_CONFIG_HOME/X11/Xresources" # you'll want to change this

#
# Cosmic stuff
#
cosmic_conf_dir="${conf_dir}/cosmic"
cosmic_dark_file="$cosmic_conf_dir/com.system76.CosmicTheme.Mode/v1/is_dark"
cosmic_bg_file="$cosmic_conf_dir/com.system76.CosmicBackground/v1/all"
# recipes for cosmic theme colour sheets
cosmic_accent_dict="base 1.0 1.0
hover 1.0 1.0
pressed 0.5 1.0
selected 1.0 1.0
selected_text 1.0 1.0
focus 1.0 1.0
divider 0.0 1.0
on 0.0 1.0
disabled 1.0 1.0
on_disabled 0.5 1.0
border 1.0 1.0
disabled_border 1.0 0.5"
cosmic_accent_button_dict="base 1.0 1.0
hover 1.0 1.0
pressed 0.5 1.0
selected 1.0 1.0
selected_text 1.0 1.0
focus 1.0 1.0
divider 0.0 1.0
on 0.0 1.0
disabled 1.0 1.0
on_disabled 0.5 0.5
border 1.0 1.0
disabled_border 1.0 0.5"

# customize this function according to your setup. By default it's
# personalised to my system, which is quite likely to differ from
# yours.
update () {
	. "$wal_cache_dir"/colors.sh
	xwallpaper --zoom "$theme_dir/$arg"/wallpaper
	cosmic_update
	# a custom theme-loading function defined in my init.el
	emacsclient -ue "(load-custom-theme 'ewal-spacemacs-modern $alpha)" &
	xrdb "$xresources" &
	dwmc xrdb &
	pywalfox update &

	[ -e "$prefix"/post-app.sh ] && sh "$prefix"/post-app.sh
}

bc_math () {
	# this function is used mainly for performing floatiing-point
	# math on 8-bit colour components. Limiting `scale' to three
	# still allows for more precision (1000 vs 256) than the 8-bit
	# colour components that are nearly ubiquitous
	echo "scale = 3; $1" | bc
}

component () {
	case "$1" in
		"red"|"r"|1)
			bound1=2
			bound2=3 ;;
		"green"|"g"|2)
			bound1=4
			bound2=5 ;;
		"blue"|"b"|3)
			bound1=6
			bound2=7 ;;
	esac
	# extract hexadecimal component and...
	hex="$(echo $2 | cut -c ${bound1}-${bound2})"
	# ...have printf convert it to decimal
	printf "%d" "0x${hex}"
}

avg_3 () {
	printf "$(($(($1 + $2 + $3)) / 3))"
}

validate_theme () {
	[ -d "$theme_dir/$arg" ] && return 0
	return 1
}

ensure_theme () {
	if [ -z "$arg" ]; then
		arg="$(ls "$theme_dir" | $dmenu_cmd)"
		[ -z "$arg" ] && echo "No theme chosen." >&2 && return 1
	fi
	validate_theme || (echo "'$arg' is not a valid theme." >&2 && return 1)
}

get_current_if_ours () {
	test="$(basename "$(grep "wallpaper" "$wal_cache_dir"/colors.json \
	                    | sed 's+/[^/]*/[^/]*$++g')")"
	if [ "$test" = "$(basename "$theme_dir")" ]; then
		arg="$(grep "wallpaper" "$wal_cache_dir"/colors.json \
		       | sed 's+/[^/]*$++g')"
		arg="$(basename "$arg")"
		return 0
	else
		echo "Current theme is not managed by newl" >&2
		return 1
	fi
}

ensure_arg_c_possible () {
	failure=""
	if [ "$arg" = "c" ]; then
		get_current_if_ours || failure="y"
	else
		ensure_theme || failure="y"
	fi
	if [ $failure ]; then
		echo "Exiting..."
		exit 1
	fi
}

cosmic_set_bg () {
	if [ "$(echo "$1" | cut -c 1)" != "/" ]; then
		echo "Cosmic needs an absolute path to wallpaper"
		exit 1
	fi

	head="$(head -n 2 "$cosmic_bg_file")"
	tail="$(tail -n 6 "$cosmic_bg_file")"
	echo "$head
    source: Path(\"$1\"),
$tail" > "$cosmic_bg_file"
}

cosmic_set_dark_or_light () {
	determinant="$(avg_3 "$(component 1 $background)" \
	                     "$(component 2 $background)" \
	                     "$(component 3 $background)")"
	if [ "$determinant" -lt 128 ]; then
		cosmic_theme_mode="Dark"
		echo "true" > "$cosmic_dark_file"
	else
		cosmic_theme_mode="Light"
		echo "false" > "$cosmic_dark_file"
	fi
}

# args:
#   1: file name of target colour sheet
#   2: colour dict; see variable `cosmic_accent_dict'
cosmic_write_colour_sheet () {
	target="$cosmic_conf_dir/com.system76.CosmicTheme.$cosmic_theme_mode/v1/$1"
	# if we write colours incrementally, the file is invalid until
	# the last write. In the meantime COSMIC switches from using
	# whatever colours are in the file to using preset colours
	target_tmp="$target".tmp
	echo "(" > "$target_tmp"
	cat "$wal_cache_dir"/colors-decimal | tail -n 1 | {
		read -r red green blue
		IFS="
"
		for colour in $2; do
			IFS=" "
			echo "$colour" | {
				read -r name mult alpha
				echo "\
    $name: (
	red: $(bc_math "${red} * $mult"),
	green: $(bc_math "${green} * $mult"),
	blue: $(bc_math "${blue} * $mult"),
	alpha: ${alpha},
    ),"
			}
		done
	} >> "$target_tmp"
	echo ")" >> "$target_tmp"
	mv "$target_tmp" "$target"
}

cosmic_set_panel_alpha () {
	for ui_element in "Panel" "Dock"; do
		cp -f "$wal_cache_dir"/alpha-decimal \
		      "$cosmic_conf_dir/com.system76.CosmicPanel.$ui_element/v1/opacity"
	done
}

cosmic_update () {
	cosmic_set_dark_or_light
	cosmic_set_bg "$theme_dir/$arg/wallpaper" &
	cosmic_write_colour_sheet accent "$cosmic_accent_dict" &
	cosmic_write_colour_sheet accent_button "$cosmic_accent_button_dict" &
	cosmic_set_panel_alpha &
}

command="$1"
arg="$2"

case "$command" in
	"")
		$0 a ;;
	"h"|"-h"|"--help")
		echo "$usage_message" ;;
	"l")
		ls "$theme_dir" ;;
	"l-icewm-menu")
		for theme in $(ls "$theme_dir"); do
			echo "prog \"$theme\" \"$theme_dir/$theme/icon\" newl a \"$theme\""
		done ;;
	"r")
		newl a "$(newl l | shuf -n 1)" ;;
	"s")
		# customise WM_CLASS/instance so our sxiv can be targeted by WMs
		arg="$($sxiv_cmd -N "newl" "$sxiv_flags" "$theme_dir"/*/wallpaper)"
		if [ -z "$arg" ]; then
			echo "No theme selected. Exiting..."
			exit 1
		fi
		arg="$(echo "$arg" | sed 's+/wallpaper$++g' | xargs basename)"
		newl a "$arg" ;;
	"n")
		if [ -z "$2" ]; then
			echo "You must supply a name for the new theme"
			exit 1
		elif validate_theme && [ -z "$3" ]; then
			echo "A theme named '$arg' already exists" \
			     "To update it, use the 'u' command" >&2
			exit 1
		fi
		# extracts filename from JSON
		dest_dir="$theme_dir/$arg"
		wp_orig="$(grep wallpaper "$wal_cache_dir"/colors.json \
		           | cut -c 19- | sed s/..$//g)"
		colours_orig="$wal_cache_dir"/colors.json
		wp_dest="$dest_dir/wallpaper"
		colours_dest="$dest_dir/colours.json"
		mkdir -p "$dest_dir"
		[ "$wp_orig" != "None" ] && cp -f "$wp_orig" "$wp_dest"
		# Fix paths; we could use sed but that'd be unreadable and
		# unnecessarily complex
		head -n 2 "$colours_orig" > "$colours_dest"
		echo "    \"wallpaper\": \"$wp_dest\"," \
			>> "$colours_dest"
		tail -n 26 "$colours_orig" >> "$colours_dest"
		# cropping assumes a landscape image
		magick "$wp_dest[x$icon_size]" \
		       -crop "${icon_size}x${icon_size}" \
		       -format png "$dest_dir/icon";;
	"a")
		ensure_arg_c_possible
		prefix="$theme_dir/$arg"
		alpha="$(grep "\"alpha\": \"" "$prefix/colours.json" \
			 | grep -o -E "[0-9]{2}[0-9]?")"
		wal -f "$prefix/colours.json" > /dev/null
		update 2>/dev/null ;;
	"i")
		ensure_arg_c_possible
		[ -e "$theme_dir/$arg/info" ] && cat "$theme_dir/$arg/info" ;;
	"e")
		ensure_arg_c_possible
		$EDITOR "$theme_dir/$arg/colours.json" ;;
	"p")
		ensure_arg_c_possible
		if [ -e "$theme_dir/$arg/post-app.sh" ]; then
			$EDITOR "$theme_dir/$arg/post-app.sh"
		else
			printf "#! /usr/bin/env sh\n\n" \
				> "$theme_dir/$arg/post-app.sh"
			$0 p "$arg"
		fi ;;
	"d")
		if [ -z "$arg" ]; then
			echo "To prevent irreversible deletion of the wrong" \
			     "theme, $name requires explicit specification of" \
			     "target"
			exit 1
		fi
		ensure_arg_c_possible
		rm -r "$theme_dir/$arg" ;;
	"u")
		ensure_arg_c_possible
		$0 n "$arg" "--force" ;;
	"install")
		if [ -z "$2" ]; then
			echo "this command needs an argument"
			exit
		fi
		for arg in "$@"; do
			if ! [ "$arg" = "$1" ]; then
				[ -e "${arg}/wallpaper" ] \
					|| echo "Warning: $arg includes no wallpaper"
				[ -e "${arg}/colours.json" ] \
					|| echo "Warning: $arg has no colours file"

				if [ -e "$theme_dir/$(basename "$arg")" ]; then
					echo "Theme $arg is already installed" \
					     " and will not be overwritten"
				else
					mkdir -p "$theme_dir"
					cp -R "$arg" "$theme_dir"
				fi
			fi
		done ;;
	*)
		echo "'$command' is not a valid command" >&2 ;;
esac
exit 0
